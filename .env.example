# Copia este fichero a .env y cambia lo que necesites
WEB_PORT=8080
POSTGRES_USER=chess
POSTGRES_PASSWORD=chess
POSTGRES_DB=chess
# Pon una cadena larga y aleatoria
# Si lo dejas vacío, la app genera uno aleatorio y lo guarda en la base de datos
JWT_SECRET=
APP_TIMEZONE=Europe/Madrid

# Revisión de partidas (más profundidad = más lento y más preciso)
ANALYSIS_DEPTH=18
ANALYSIS_THREADS=2

# Puzzles a importar de Lichess (0 = todos, ~5 millones tras el filtro)
PUZZLE_LIMIT=1000000
